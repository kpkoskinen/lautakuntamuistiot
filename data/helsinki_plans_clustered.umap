{"type":"umap","properties":{"name":"Kaupunkiympäristölautakunnan suunnitelmat ja kaavat 2013–2026","description":"Helsinki committee plan decisions and Kerro kantasi consultations, coloured by plan type. Numbers are groups of pins: click to zoom in; where several plans share one spot, click the number again to fan them out, then click the pins one by one (close a popup with ×; a click on the map closes the fan). Hover a pin for a preview. Decisions: City of Helsinki (paatokset.hel.fi), Kerro kantasi; locations geocoded with Nominatim, © OpenStreetMap contributors (ODbL). Experimental, heuristically extracted: pins are approximate.","shortCredit":"Data: City of Helsinki, © OpenStreetMap contributors (ODbL)","zoom":12,"popupShape":"Large","tilelayer":{"name":"Jawg Light","minZoom":0,"maxZoom":18,"tms":false,"url_template":"https://tile.jawg.io/jawg-light/{z}/{x}/{y}.png?api-key=community","attribution":"Tiles courtesy of [[https://www.jawg.io/|jawgmaps]] - Map data [[http://osm.org/copyright/|&copy; OpenStreetMap contributors]], under ODbL."},"fields":[{"key":"name","type":"String"},{"key":"description","type":"Text"},{"key":"plan_type_label","type":"String"},{"key":"stage","type":"String"},{"key":"year","type":"Number"}],"filters":[{"fieldKey":"plan_type_label","widget":"Checkbox","label":"Plan type"},{"fieldKey":"stage","widget":"Checkbox","label":"Stage"},{"fieldKey":"year","widget":"MinMax","label":"Year"}],"onLoadPanel":"caption"},"geometry":{"type":"Point","coordinates":[24.94,60.19]},"layers":[{"type":"FeatureCollection","features":[],"properties":{"name":"Plans and consultations","color":"#4a4a4a","type":"Cluster","cluster":{"radius":60},"showLabel":null,"labelKey":"hover","iconClass":"Circle","displayOnLoad":true,"browsable":true,"inCaption":true,"remoteData":{"url":"https://raw.githubusercontent.com/kpkoskinen/lautakuntamuistiot/main/data/umap/all.geojson","format":"geojson"}}}]}